{
  "name": "devdock-desktop",
  "version": "1.2.0",
  "license": "MIT",
  "description": "Everything running. One dock. Servers, sessions, containers, apps and agents on your Mac.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "build": {
    "appId": "com.devdock.desktop",
    "productName": "DevDock",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "DevDock",
      "icon": "assets/icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 180,
          "y": 170
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "asar": true,
    "asarUnpack": [
      "server.js",
      "sources/**/*",
      "agents/**/*",
      "assets/**/*",
      "public/**/*",
      "views/**/*",
      "node_modules/**/*"
    ],
    "files": [
      "electron/**/*",
      "server.js",
      "sources/**/*",
      "agents/**/*",
      "assets/**/*",
      "public/**/*",
      "views/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.19.0",
    "node-pty": "1.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
