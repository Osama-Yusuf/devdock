{
  "name": "devdock-desktop",
  "version": "1.4.0",
  "license": "MIT",
  "description": "Everything running. One dock. Servers, sessions, containers, apps and agents on your Mac.",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test test/",
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:mac": "npm run build:key && npm run build:info && electron-builder --mac",
    "build:info": "node -e \"const x=c=>require('child_process').execSync(c).toString().trim();require('fs').writeFileSync('build.json',JSON.stringify({version:require('./package.json').version,build:x('git rev-list --count HEAD')+' ('+x('git rev-parse --short HEAD')+')'}))\"",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "build:key": "swiftc -O native/devdock-key.swift -o native/devdock-key"
  },
  "build": {
    "appId": "com.devdock.desktop",
    "productName": "DevDock",
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "DevDock",
      "icon": "assets/icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 180,
          "y": 170
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "asar": true,
    "asarUnpack": [
      "server.js",
      "build.json",
      "native/devdock-key",
      "agent/install-agent.sh",
      "sources/**/*",
      "agents/**/*",
      "assets/**/*",
      "public/**/*",
      "views/**/*",
      "node_modules/**/*"
    ],
    "files": [
      "electron/**/*",
      "server.js",
      "build.json",
      "sources/**/*",
      "agents/**/*",
      "assets/**/*",
      "public/**/*",
      "views/**/*",
      "node_modules/**/*",
      "native/devdock-key",
      "agent/install-agent.sh"
    ]
  },
  "dependencies": {
    "express": "^4.19.0",
    "node-pty": "1.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
